PORT=5000
CLIENT_URL=http://localhost:5173

# Database Settings
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=gms_db

# Auth
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=8h

# Multi-tenancy: code of the default garage created by the migration
# (the settings below are applied to it). Super admins add more garages
# from the Garages page in the app.
GARAGE_CODE="ADMIN"

# Default Garage Settings (used for the initial garage only; later editable
# per garage in the Settings page)
GARAGE_NAME="My Auto Workshop"
GARAGE_ADDRESS="123 Mechanic Street"
GARAGE_PHONE="+1234567890"
CURRENCY="AED"
TAX_RATE=5

# WhatsApp Settings (Option A configuration)
WHATSAPP_DEFAULT_COUNTRY_CODE="971"


# Public URL for WhatsApp share links (invoice PDF)
PUBLIC_URL=http://localhost:5000
